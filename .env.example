CLIENT_ID=your_strava_client_id
CLIENT_SECRET=your_strava_client_secret

# Optional: For AI analysis features (--ai and --roast flags)
# Uncomment ONE of the following based on your LLM provider:

# OpenAI (GPT-4, GPT-3.5, etc.)
# OPENAI_API_KEY=sk-...

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GOOGLE_API_KEY=...
